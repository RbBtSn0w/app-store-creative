{
  "project": {
    "id": "studio-reference",
    "name": "Studio reference fixture",
    "bundleId": "com.example.studioreference",
    "defaultLocale": "en-US",
    "locales": [
      "en-US",
      "zh-Hans"
    ]
  },
  "targets": [
    "iphone_6_9",
    "mac_16_10"
  ],
  "theme": {
    "background": {
      "type": "gradient",
      "colors": [
        "#17213b",
        "#311042"
      ],
      "angle": 110
    }
  },
  "studio": {
    "requireExportEvidence": true
  },
  "cards": [

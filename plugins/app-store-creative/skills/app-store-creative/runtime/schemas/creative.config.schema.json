{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppStoreCreativeConfig",
  "description": "Declarative configuration schema for App Store Creative releases (v2.0)",
  "type": "object",
  "required": [
    "project",
    "theme",
    "cards"
  ],
  "properties": {
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Storage path resolved relative to the consuming project root; external locations require explicit absolute paths."
        },
        "objectRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Storage path resolved relative to the consuming project root; external locations require explicit absolute paths."
        },
        "releaseRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Storage path resolved relative to the consuming project root; external locations require explicit absolute paths."
        },
        "publicationRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Storage path resolved relative to the consuming project root; external locations require explicit absolute paths."
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "bundleId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project"
        },
        "name": {
          "type": "string",
          "description": "Product display name"
        },
        "bundleId": {
          "type": "string",
          "description": "Apple bundle identifier (e.g. com.example.app)"
        },
        "defaultLocale": {
          "type": "string",
          "default": "en-US"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "en-US"
          ]
        }
      }
    },
    "targets": {
      "type": "array",
      "description": "Target App Store device form factors to generate",
      "items": {
        "type": "string",
        "enum": [
          "iphone_6_9",
          "iphone_6_7",
          "iphone_6_5",
          "iphone_5_5",
          "ipad_13",
          "ipad_12_9",
          "mac_16_10",
          "watch_ultra",
          "google_play_phone",
          "google_play_tablet_7",
          "google_play_tablet_10",
          "google_play_feature_graphic"
        ]
      },
      "default": [
        "iphone_6_9"
      ]
    },
    "theme": {
      "type": "object",
      "description": "Global visual styling for screenshot cards",
      "properties": {
        "stylePreset": {
          "type": "string",
          "enum": [
            "liquid_glass",
            "swiss_grid",
            "midnight_glow",
            "quiet_japandi",
            "bento_keynote",
            "candy_pop",
            "neon_athletic",
            "magazine_editorial",
            "soft_clay",
            "pastel_dream",
            "vintage_travel",
            "cyber_matrix",
            "clean_light",
            "dark_contrast",
            "ocean_gradient",
            "sunset_warmth",
            "forest_minimal",
            "monochrome_bold"
          ],
          "description": "Pre-configured visual style preset applying cohesive palette, typography, and atmospheric lighting"
        },
        "background": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "solid",
                "gradient",
                "mesh",
                "image"
              ],
              "default": "gradient"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "#0F172A",
                "#1E293B"
              ]
            },
            "angle": {
              "type": "number",
              "default": 135
            },
            "imageUrl": {
              "type": "string",
              "description": "Project-relative local background image path."
            }
          }
        },
        "fontFamily": {
          "type": "string",
          "default": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif"
        },
        "headlineColor": {
          "type": "string",
          "default": "#FFFFFF"
        },
        "subheadlineColor": {
          "type": "string",
          "default": "rgba(255, 255, 255, 0.75)"
        },
        "bezelStyle": {
          "type": "string",
          "enum": [
            "natural",
            "titanium_black",
            "titanium_natural",
            "silver",
            "midnight",
            "flat"
          ],
          "default": "natural"
        },
        "shadow": {
          "type": "string",
          "enum": [
            "soft",
            "dramatic",
            "subtle",
            "none"
          ],
          "default": "dramatic"
        }
      }
    },
    "connectedTrack": {
      "type": "boolean",
      "default": false,
      "description": "When true, cards form a continuous canvas panorama where elements span across card boundaries"
    },
    "cards": {
      "type": "array",
      "description": "Sequence of marketing screenshot cards",
      "items": {
        "type": "object",
        "required": [
          "id",
          "headline"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Card identifier (e.g. 01-hero)"
          },
          "headline": {
            "type": "string",
            "description": "Primary value-proposition headline"
          },
          "subheadline": {
            "type": "string",
            "description": "Supporting explanatory text"
          },
          "screenshot": {
            "type": "string",
            "description": "Relative path to raw source screenshot image"
          },
          "layout": {
            "type": "string",
            "enum": [
              "phone_bottom",
              "phone_center",
              "phone_tilt_left",
              "phone_tilt_right",
              "phone_bleed",
              "split_dual",
              "pure_text",
              "phone_floating_isometric",
              "phone_perspective_hero",
              "split_dual_perspective",
              "feature_graphic_banner",
              "mac_native_hero",
              "mac_native_left",
              "mac_native_right"
            ],
            "default": "phone_bottom"
          },
          "deviceOffset": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "default": 0
              },
              "y": {
                "type": "number",
                "default": 0
              },
              "scale": {
                "type": "number",
                "default": 1
              },
              "rotate": {
                "type": "number",
                "default": 0
              },
              "rotateX": {
                "type": "number",
                "default": 0
              },
              "rotateY": {
                "type": "number",
                "default": 0
              }
            }
          },
          "customBackground": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "solid",
                  "gradient",
                  "image"
                ]
              },
              "colors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "angle": {
                "type": "number"
              },
              "imageUrl": {
                "type": "string",
                "description": "Project-relative local background image path."
              }
            }
          },
          "variants": {
            "type": "object",
            "description": "Additive target-specific capture/layout overrides. Target localization overrides project localization.",
            "propertyNames": {
              "enum": [
                "iphone_6_9",
                "iphone_6_7",
                "iphone_6_5",
                "iphone_5_5",
                "ipad_13",
                "ipad_12_9",
                "mac_16_10",
                "watch_ultra",
                "google_play_phone",
                "google_play_tablet_7",
                "google_play_tablet_10",
                "google_play_feature_graphic"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "screenshot": {
                  "type": "string",
                  "description": "Relative path to raw source screenshot image"
                },
                "layout": {
                  "type": "string",
                  "enum": [
                    "phone_bottom",
                    "phone_center",
                    "phone_tilt_left",
                    "phone_tilt_right",
                    "phone_bleed",
                    "split_dual",
                    "pure_text",
                    "phone_floating_isometric",
                    "phone_perspective_hero",
                    "split_dual_perspective",
                    "feature_graphic_banner",
                    "mac_native_hero",
                    "mac_native_left",
                    "mac_native_right"
                  ],
                  "default": "phone_bottom"
                },
                "deviceOffset": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "default": 0
                    },
                    "y": {
                      "type": "number",
                      "default": 0
                    },
                    "scale": {
                      "type": "number",
                      "default": 1
                    },
                    "rotate": {
                      "type": "number",
                      "default": 0
                    },
                    "rotateX": {
                      "type": "number",
                      "default": 0
                    },
                    "rotateY": {
                      "type": "number",
                      "default": 0
                    }
                  }
                },
                "localizations": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "headline": {
                        "type": "string"
                      },
                      "subheadline": {
                        "type": "string"
                      },
                      "screenshot": {
                        "type": "string",
                        "description": "Relative path to the product capture for this locale"
                      },
                      "inheritDefault": {
                        "type": "boolean",
                        "description": "Explicit review acceptance of inherited default copy or capture for this locale and target."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "publishing": {
      "type": "object",
      "description": "Optional target hints for the official ASC agent; never upload authorization.",
      "properties": {
        "appId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        }
      }
    },
    "previewVideo": {
      "type": "object",
      "description": "App Preview video production configuration",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "source": {
          "type": "string",
          "description": "Relative path to raw screen recording"
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          },
          "description": "Optional project locales that receive this video; defaults to all project locales."
        },
        "posterFrameTimeCode": {
          "type": "string",
          "description": "Optional poster frame timecode for ASC review, for example 00:00:05:00."
        },
        "fps": {
          "type": "number",
          "default": 30
        },
        "duration": {
          "type": "number",
          "default": 20
        },
        "posterRequired": {
          "type": "boolean",
          "default": false,
          "description": "Require a selected poster artifact bound to the preview in the release matrix."
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape"
          ],
          "default": "portrait"
        },
        "width": {
          "type": "integer",
          "description": "Explicit output video width in pixels"
        },
        "height": {
          "type": "integer",
          "description": "Explicit output video height in pixels"
        },
        "audio": {
          "type": "object",
          "properties": {
            "required": {
              "type": "boolean",
              "default": false
            },
            "addSilentTrackIfMissing": {
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    },
    "localizations": {
      "type": "object",
      "description": "Localized copy and optional source capture: locale -> card_id -> { headline, subheadline, screenshot }",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string"
            },
            "subheadline": {
              "type": "string"
            },
            "screenshot": {
              "type": "string",
              "description": "Relative path to the product capture for this locale"
            },
            "inheritDefault": {
              "type": "boolean",
              "description": "Explicit review acceptance of inherited default copy or capture for this locale and target."
            }
          }
        }
      }
    },
    "studio": {
      "type": "object",
      "properties": {
        "requireExportEvidence": {
          "type": "boolean",
          "default": false,
          "description": "Require current config, source, output, and render-readiness evidence for every declared screenshot. Studio-created projects enable this. This is an explicit validation policy setting, not a historical compatibility mode."
        }
      }
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "trialRetentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "diagnosticRetentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "quarantineDays": {
          "type": "integer",
          "minimum": 0
        },
        "mediaBudgetBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
